# Only for `vite dev`, where the API runs on another port. A production build talks to `/api/v1` on its own origin.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Fallbacks only: the real upload limits come from GET /auth/me (capabilities.uploads).
# VITE_MAX_UPLOAD_BYTES=26214400
# VITE_DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,png,jpg,jpeg,gif,webp,txt,csv,zip
