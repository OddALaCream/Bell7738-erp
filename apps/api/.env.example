# Copy to `apps/api/.env` for running the API directly on the host
# (pnpm --filter api start:dev) against the Postgres container started via
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres`
# (docker-compose.dev.yml publishes it on localhost:55432 for local
# development only). Credentials are the app role created by
# deploy/postgres/init/ (owns only this database; has CREATEDB so
# `prisma migrate dev` can create its shadow database — not the
# POSTGRES_USER superuser).

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
APP_TIME_ZONE=UTC
LOG_LEVEL=debug

DATABASE_URL=postgresql://startup_erp_app:change-me@localhost:55432/startup_erp

JWT_ACCESS_SECRET=change-me-32-bytes-minimum-dev-only
JWT_REFRESH_SECRET=change-me-32-bytes-minimum-dev-only
REFRESH_TOKEN_HASH_SECRET=change-me-32-bytes-minimum-dev
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
INVITATION_TTL_HOURS=72

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-dev-password
OWNER_FIRST_NAME=Owner
OWNER_LAST_NAME=Account

STORAGE_ROOT=./uploads
MAX_UPLOAD_BYTES=26214400

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
