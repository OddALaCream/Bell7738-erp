# Copy to `.env` for `docker compose`. Never commit the real `.env`.
# For running apps/api directly on the host (outside Docker), see
# apps/api/.env.example instead — hostnames differ (postgres vs localhost).

# --- Application ---
NODE_ENV=production
APP_BASE_URL=https://erp.example.com
WEB_ORIGIN=https://erp.example.com
APP_TIME_ZONE=UTC
LOG_LEVEL=info
APP_DOMAIN=erp.example.com

# --- PostgreSQL ---
# POSTGRES_USER is the superuser the official image bootstraps with; the app
# never authenticates as it. APP_DB_USER is a least-privileged role (owner of
# just this database) created by deploy/postgres/init/ on first start — that
# is what DATABASE_URL points at.
POSTGRES_DB=startup_erp
POSTGRES_USER=startup_erp_root
POSTGRES_PASSWORD=change-me
APP_DB_USER=startup_erp_app
APP_DB_PASSWORD=change-me
DATABASE_URL=postgresql://startup_erp_app:change-me@postgres:5432/startup_erp

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
JWT_ACCESS_SECRET=change-me-32-bytes-minimum
JWT_REFRESH_SECRET=change-me-32-bytes-minimum
REFRESH_TOKEN_HASH_SECRET=change-me-32-bytes-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=true
INVITATION_TTL_HOURS=72
PROJECTS_ENDING_SOON_DAYS=7

# --- Owner bootstrap (used once by the seed; remove OWNER_PASSWORD after first run) ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
OWNER_FIRST_NAME=Owner
OWNER_LAST_NAME=Account

# --- Storage ---
MAX_UPLOAD_BYTES=26214400

# --- SMTP (optional; leave blank to disable email and use manual invitation links) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Web Push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
